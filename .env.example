# Copy to .env and fill in the values your config/watchpost.yaml actually
# references with ${VAR}. Delete any line you don't use; an unset variable
# that IS referenced makes watchpost fail to start (by design, see
# observe/config.py). Secrets that are files instead (${file:/run/secrets/x})
# go under ./secrets, not here.

# Dashboard basic auth (optional, see config.example.yaml "web:")
WATCHPOST_UI_PASSWORD=

# SNMP
SNMP_COMMUNITY=
SNMP_AUTH=
SNMP_PRIV=

# Windows / WinRM
WINRM_PASSWORD=

# Active Directory discovery
AD_PASSWORD=

# TrueNAS
TRUENAS_API_KEY=

# Proxmox VE
PROXMOX_TOKEN_SECRET=

# VMware vSphere
VSPHERE_PASSWORD=

# Home Assistant
HA_TOKEN=

# UniFi Network / Protect
UNIFI_API_KEY=

# Technitium DNS
TECHNITIUM_TOKEN=

# MQTT
MQTT_PASSWORD=

# ntfy
NTFY_TOKEN=
